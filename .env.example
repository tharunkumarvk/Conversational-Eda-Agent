# EDA Agent Configuration
# Copy this file to .env and fill in your actual values

# ===== REQUIRED: Google Gemini API Key =====
GOOGLE_API_KEY=your_gemini_api_key_here

# ===== Per-feature Gemini API Keys (optional, falls back to GOOGLE_API_KEY) =====
GEMINI_SMART_CLEAN_KEY=your_smart_clean_api_key_here
GEMINI_FULL_PREPROCESS_KEY=your_full_preprocess_api_key_here
GEMINI_AUTO_VIZ_KEY=your_auto_viz_api_key_here

# ===== REQUIRED: Google OAuth Client ID =====
GOOGLE_CLIENT_ID=your_google_client_id_here

# ===== REQUIRED: JWT Secret Key (min 32 characters) =====
JWT_SECRET_KEY=your_super_secret_jwt_key_at_least_32_characters_long

# ===== Frontend URL (for CORS) =====
FRONTEND_URL=http://localhost:5173

# ===== Database Configuration (legacy - replaced by DynamoDB) =====
# DATABASE_URL=sqlite:///./streamlit_users.db

# ===== Supabase Storage (legacy - replaced by S3) =====
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_BUCKET_NAME=

# ============================================================
# AWS Configuration
# ============================================================

# --- Authentication Mode ---
# Options: "false" (disabled), "local" (bcrypt/SQLAlchemy), "cognito" (AWS Cognito)
AUTH_MODE=false

# --- AWS Core Credentials ---
# Get from: AWS Console > IAM > Users > Security Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- App Naming ---
AWS_APP_NAME=eda-agent
AWS_ENVIRONMENT=production

# --- DynamoDB Table Names (auto-set from CloudFormation, override if needed) ---
# AWS_DYNAMODB_USERS_TABLE=eda-agent-users-production
# AWS_DYNAMODB_SESSIONS_TABLE=eda-agent-sessions-production
# AWS_DYNAMODB_CHAT_TABLE=eda-agent-chat-history-production
# AWS_DYNAMODB_FILES_TABLE=eda-agent-files-production
# AWS_DYNAMODB_ANALYSES_TABLE=eda-agent-analyses-production

# --- Cognito (from CloudFormation outputs) ---
# AWS_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
# AWS_COGNITO_CLIENT_ID=your-cognito-app-client-id

# --- SQS (from CloudFormation outputs) ---
# AWS_SQS_PROCESSING_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/eda-agent-eda-processing-production
# AWS_SQS_NOTIFICATION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT/eda-agent-notifications-production

# --- Lambda ---
# AWS_LAMBDA_EDA_PROCESSOR=eda-agent-eda-processor-production

# --- S3 ---
# AWS_S3_BUCKET=eda-agent-files-ACCOUNTID-production

# --- CloudWatch ---
# AWS_CLOUDWATCH_LOG_GROUP=/eda-agent/production/app

