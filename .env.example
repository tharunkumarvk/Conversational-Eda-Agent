# EDA Agent Configuration
# Copy this file to .env and fill in your actual values

# ===== REQUIRED: Google Gemini API Key =====
GOOGLE_API_KEY=your_gemini_api_key_here

# ===== Database Configuration =====
# Option 1: SQLite (Local, Default)
DATABASE_URL=sqlite:///./backend/eda_agent.db

# Option 2: Supabase (PostgreSQL Cloud) - Uncomment and replace with your connection string
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Option 3: Neon (PostgreSQL Cloud) - Uncomment and replace with your connection string
# DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Option 4: PlanetScale (MySQL Cloud) - Uncomment and replace with your connection string
# DATABASE_URL=mysql://user:password@aws.connect.psdb.cloud/database?ssl={"rejectUnauthorized":true}

# ===== Optional Configuration =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== File Upload Settings =====
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=uploaded_files

# ===== Supabase Storage (Cloud File Storage) =====
# Get these from: Supabase Dashboard > Settings > API
# After creating a storage bucket, add these credentials:
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=your_anon_public_key_here
# SUPABASE_BUCKET=eda-files

