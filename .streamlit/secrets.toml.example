# Streamlit Secrets Configuration (EXAMPLE)
# Copy this to .streamlit/secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to git!

# ===== REQUIRED: Google Gemini API =====
GOOGLE_API_KEY = "your_gemini_api_key_here"

# ===== Database Configuration =====
# Option 1: SQLite (for local testing only)
DATABASE_URL = "sqlite:///./streamlit_users.db"

# Option 2: MySQL on your laptop (local development)
# DATABASE_URL = "mysql+pymysql://username:password@localhost:3306/eda_database"

# Option 3: PlanetScale MySQL (FREE - Recommended for deployment)
# DATABASE_URL = "mysql+pymysql://username:password@aws.connect.psdb.cloud/database_name?ssl_ca=/etc/ssl/certs/ca-certificates.crt"

# Option 4: Supabase PostgreSQL (FREE - Alternative for deployment)
# DATABASE_URL = "postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# ===== Optional: Supabase Storage (for file storage) =====
SUPABASE_URL = ""  # e.g., https://xxxxx.supabase.co
SUPABASE_KEY = ""  # anon/public key
SUPABASE_BUCKET = "eda-files"

# ===== Optional: Google OAuth =====
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
